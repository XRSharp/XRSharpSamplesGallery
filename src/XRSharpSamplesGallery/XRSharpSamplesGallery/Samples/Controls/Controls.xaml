<xr:UserControl3D x:Class="XRSharpSamplesGallery.Samples.Controls"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:local="clr-namespace:XRSharpSamplesGallery.Samples"
                  xmlns:other="clr-namespace:XRSharpSamplesGallery.Other"
                  xmlns:xr="http://xrsharp.io/xr">

    <xr:UserControl3D.Resources>
        <Style x:Key="Button3D_Style" TargetType="xr:Button3D">
            <Setter Property="SizeX" Value="0.03"/>
            <Setter Property="SizeY" Value="0.03"/>
            <Setter Property="SizeZ" Value="0.01"/>
            <Setter Property="Background" Value="#FF3C3C3C"/>
            <Setter Property="Foreground" Value="#FFBBBBBB"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Padding" Value="0.005"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="xr:Button3D">
                        <xr:Grid3D>
                            <xr:VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal"/>
                                    <VisualState Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="BackgroundBox"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#3A3A50"
                                                            Duration="00:00:00.2"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Scale">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1 1 0.2"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </xr:VisualStateManager.VisualStateGroups>
                            <xr:RoundedBox Name="BackgroundBox"
                                           CastShadows="False"
                                           Radius="0.02"
                                           ReceiveShadows="False"
                                           SizeX="{TemplateBinding SizeX}"
                                           SizeY="{TemplateBinding SizeY}"
                                           SizeZ="{TemplateBinding SizeZ}"
                                           Color="{TemplateBinding Background}"/>
                            <xr:Viewbox3D Margin="0 0 0 0 0 -0.001"
                                          AlignmentX="Center"
                                          AlignmentY="Center"
                                          AlignmentZ="End"
                                          SizeX="0.1"
                                          SizeY="0.1"
                                          SizeZ="0.001">
                                <xr:Text3D FontSize="0.02"
                                           Text="{TemplateBinding Content}"
                                           Thickness="0.001"
                                           Color="White"/>
                            </xr:Viewbox3D>
                        </xr:Grid3D>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DefaultRepeatButton3DStyle" TargetType="xr:RepeatButton3D">
            <Setter Property="Background" Value="#FF1F3B53"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="#FF718597"/>
            <Setter Property="Padding" Value="0 0 0.05 0 0 0"/>
            <Setter Property="Radius" Value="0.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContentAlignmentX" Value="Center"/>
            <Setter Property="ContentAlignmentY" Value="Center"/>
            <Setter Property="ContentAlignmentZ" Value="Center"/>

            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <xr:Grid3D>
                            <xr:Text3D FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=xr:RepeatButton3D}}"
                                       Text="{Binding}"
                                       Color="{Binding Foreground, RelativeSource={RelativeSource AncestorType=xr:RepeatButton3D}}"/>
                        </xr:Grid3D>
                    </DataTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="xr:RepeatButton3D">
                        <xr:Grid3D>
                            <xr:VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal"/>
                                    <VisualState Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Scale">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1.1 1.1 1.1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Box"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.9"
                                                             Duration="00:00:00.1"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState Name="Disabled">
                                        <Storyboard/>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard/>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                </VisualStateGroup>
                            </xr:VisualStateManager.VisualStateGroups>
                            <xr:RoundedBoxBorder Margin="0"
                                                 AlignmentX="Center"
                                                 AlignmentY="Center"
                                                 AlignmentZ="Center"
                                                 Radius="{TemplateBinding Radius}"
                                                 SizeX="{TemplateBinding SizeX}"
                                                 SizeY="{TemplateBinding SizeY}"
                                                 SizeZ="{TemplateBinding SizeZ}"
                                                 Thickness="{TemplateBinding BorderThickness}"
                                                 Color="{TemplateBinding BorderBrush}"/>
                            <xr:Rectangle3D Name="Box"
                                            Margin="0"
                                            AlignmentX="Center"
                                            AlignmentY="Center"
                                            AlignmentZ="Center"
                                            Radius="{TemplateBinding Radius}"
                                            SizeX="{TemplateBinding SizeX}"
                                            SizeY="{TemplateBinding SizeY}"
                                            SizeZ="{TemplateBinding SizeZ}"
                                            Color="{TemplateBinding Background}"/>

                            <xr:ContentPresenter3D x:Name="ContentPresenter"
                                                   Margin="{TemplateBinding Padding}"
                                                   AlignmentX="{TemplateBinding ContentAlignmentX}"
                                                   AlignmentY="{TemplateBinding ContentAlignmentY}"
                                                   AlignmentZ="{TemplateBinding ContentAlignmentZ}"
                                                   Content="{TemplateBinding Content}"
                                                   ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </xr:Grid3D>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DefaultToggleButton3DStyle" TargetType="xr:ToggleButton3D">
            <Setter Property="Background" Value="#FF1F3B53"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="BorderBrush" Value="#FF718597"/>
            <Setter Property="Padding" Value="0 0 0.05 0 0 0"/>
            <Setter Property="Radius" Value="0.5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContentAlignmentX" Value="Center"/>
            <Setter Property="ContentAlignmentY" Value="Center"/>
            <Setter Property="ContentAlignmentZ" Value="Center"/>

            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <xr:Grid3D>
                            <xr:Text3D FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=xr:ToggleButton3D}}"
                                       Text="{Binding}"
                                       Color="{Binding Foreground, RelativeSource={RelativeSource AncestorType=xr:ToggleButton3D}}"/>
                        </xr:Grid3D>
                    </DataTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="xr:ToggleButton3D">
                        <xr:Grid3D>
                            <xr:VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal"/>
                                    <VisualState Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Scale">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1.1 1.1 1.1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Box"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.9"
                                                             Duration="00:00:00.1"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState Name="Disabled">
                                        <Storyboard/>
                                    </VisualState>
                                </VisualStateGroup>

                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ColorAnimationUsingKeyFrames Storyboard.TargetName="Box" Storyboard.TargetProperty="Color">
                                                <DiscreteColorKeyFrame KeyTime="0" Value="green"/>
                                            </ColorAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked"/>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard/>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                </VisualStateGroup>
                            </xr:VisualStateManager.VisualStateGroups>
                            <xr:RoundedBoxBorder Margin="0"
                                                 AlignmentX="Center"
                                                 AlignmentY="Center"
                                                 AlignmentZ="Center"
                                                 Radius="{TemplateBinding Radius}"
                                                 SizeX="{TemplateBinding SizeX}"
                                                 SizeY="{TemplateBinding SizeY}"
                                                 SizeZ="{TemplateBinding SizeZ}"
                                                 Thickness="{TemplateBinding BorderThickness}"
                                                 Color="{TemplateBinding BorderBrush}"/>
                            <xr:Rectangle3D Name="Box"
                                            Margin="0"
                                            AlignmentX="Center"
                                            AlignmentY="Center"
                                            AlignmentZ="Center"
                                            Radius="{TemplateBinding Radius}"
                                            SizeX="{TemplateBinding SizeX}"
                                            SizeY="{TemplateBinding SizeY}"
                                            SizeZ="{TemplateBinding SizeZ}"
                                            Color="{TemplateBinding Background}"/>

                            <xr:ContentPresenter3D x:Name="ContentPresenter"
                                                   Margin="{TemplateBinding Padding}"
                                                   AlignmentX="{TemplateBinding ContentAlignmentX}"
                                                   AlignmentY="{TemplateBinding ContentAlignmentY}"
                                                   AlignmentZ="{TemplateBinding ContentAlignmentZ}"
                                                   Content="{TemplateBinding Content}"
                                                   ContentTemplate="{TemplateBinding ContentTemplate}"/>
                        </xr:Grid3D>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="DefaultCheckBox3DStyle" TargetType="xr:CheckBox3D">
            <Setter Property="Background" Value="#FF448DCA"/>
            <Setter Property="Foreground" Value="#FF000000"/>
            <Setter Property="BorderThickness" Value="0.3"/>
            <Setter Property="BorderBrush" Value="#FF718597"/>
            <Setter Property="Padding" Value="0,0.05,0.05"/>
            <Setter Property="Radius" Value="0.05"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="ContentAlignmentX" Value="Start"/>
            <Setter Property="ContentAlignmentY" Value="Center"/>
            <Setter Property="ContentAlignmentZ" Value="Center"/>

            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <xr:Text3D FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=xr:CheckBox3D}}"
                                   Text="{Binding}"
                                   Color="{Binding Foreground, RelativeSource={RelativeSource AncestorType=xr:CheckBox3D}}"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="xr:CheckBox3D">
                        <xr:Grid3D>
                            <xr:VisualStateManager.VisualStateGroups>
                                <VisualStateGroup Name="CommonStates">
                                    <VisualState Name="Normal"/>
                                    <VisualState Name="MouseOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Grid" Storyboard.TargetProperty="Scale">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="1.1 1.1 1.1"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="Box"
                                                             Storyboard.TargetProperty="Opacity"
                                                             To="0.9"
                                                             Duration="00:00:00.1"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState Name="Disabled">
                                        <Storyboard/>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="CheckStates">
                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CheckIcon" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Unchecked"/>
                                    <VisualState x:Name="Indeterminate">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="IndeterminateIcon" Storyboard.TargetProperty="Visibility">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="Visible"/>
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                                <VisualStateGroup x:Name="FocusStates">
                                    <VisualState x:Name="Focused">
                                        <Storyboard/>
                                    </VisualState>
                                    <VisualState x:Name="Unfocused"/>
                                </VisualStateGroup>

                            </xr:VisualStateManager.VisualStateGroups>

                            <xr:StackPanel3D>
                                <xr:Grid3D x:Name="Grid">
                                    <xr:Rectangle3D Name="Box"
                                                    Margin="0"
                                                    AlignmentX="Start"
                                                    AlignmentY="Start"
                                                    AlignmentZ="Start"
                                                    Radius="{TemplateBinding Radius}"
                                                    SizeX="{TemplateBinding SizeX}"
                                                    SizeY="{TemplateBinding SizeY}"
                                                    SizeZ="{TemplateBinding SizeZ}"
                                                    Color="{TemplateBinding Background}"/>
                                    <xr:GltfModel Name="CheckIcon"
                                                  Margin="0.1,0.12,0,0,0,-0.05"
                                                  AlignmentX="Center"
                                                  AlignmentY="Center"
                                                  AlignmentZ="End"
                                                  Scale="0.1 0.1 0.1"
                                                  SizeX="{TemplateBinding SizeX}"
                                                  SizeY="{TemplateBinding SizeY}"
                                                  SizeZ="{TemplateBinding SizeZ}"
                                                  Source="/XRSharp;component/Resources/tick.glb"
                                                  Visibility="Hidden"/>
                                    <xr:Rectangle3D Name="IndeterminateIcon"
                                                    AlignmentX="Start"
                                                    AlignmentY="Start"
                                                    AlignmentZ="Start"
                                                    Radius="{TemplateBinding Radius}"
                                                    SizeX="{TemplateBinding SizeX}"
                                                    SizeY="{TemplateBinding SizeY}"
                                                    SizeZ="{TemplateBinding SizeZ}"
                                                    Visibility="Hidden"
                                                    Color="Blue"/>
                                </xr:Grid3D>

                                <xr:ContentPresenter3D x:Name="ContentPresenter"
                                                       Margin="{TemplateBinding Padding}"
                                                       AlignmentX="{TemplateBinding ContentAlignmentX}"
                                                       AlignmentY="{TemplateBinding ContentAlignmentY}"
                                                       AlignmentZ="{TemplateBinding ContentAlignmentZ}"
                                                       Content="{TemplateBinding Content}"
                                                       ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </xr:StackPanel3D>
                        </xr:Grid3D>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ControlSampleTemplate" TargetType="other:HeaderedContentControl3D">
            <Setter Property="AlignmentY" Value="Start"/>
            <Setter Property="xr:Canvas3D.IsDraggable" Value="True"/>
            <Setter Property="Margin" Value="0.02,0,0"/>
            <Setter Property="HeaderTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <xr:Text3D Margin="0,0.02,0.1,0,0,0"
                                   Text="{Binding}"
                                   Color="#404040"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </xr:UserControl3D.Resources>

    <xr:Canvas3D>
        <xr:StackPanel3D xr:Canvas3D.X="-0.65"
                         xr:Canvas3D.Z="-0.15"
                         Orientation="XAxis">
            <other:HeaderedContentControl3D Header="Button3D" Style="{StaticResource ControlSampleTemplate}">
                <xr:Button3D Background="Red"
                             Click="OnButton3DClick"
                             Content="Click"
                             SizeX="0.16"
                             SizeY="0.16"
                             SizeZ="0.04"
                             Style="{StaticResource Button3D_Style}"/>
            </other:HeaderedContentControl3D>

            <other:HeaderedContentControl3D Header="RepeatButton3D" Style="{StaticResource ControlSampleTemplate}">
                <xr:RepeatButton3D Padding="0 0 0.035 0 0 0"
                                   Click="OnRepeatButton3DClick"
                                   Content="Repeat"
                                   FontSize="0.02"
                                   SizeX="0.16"
                                   SizeY="0.16"
                                   SizeZ="0.04"
                                   Style="{StaticResource DefaultRepeatButton3DStyle}"/>
            </other:HeaderedContentControl3D>

            <other:HeaderedContentControl3D Header="ToggleButton3D" Style="{StaticResource ControlSampleTemplate}">
                <xr:ToggleButton3D Padding="0 0 0.035 0 0 0"
                                   Click="OnToggleButton3DClick"
                                   Content="Toggle"
                                   ContentAlignmentZ="End"
                                   FontSize="0.015"
                                   IsThreeState="True"
                                   SizeX="0.16"
                                   SizeY="0.16"
                                   SizeZ="0.04"
                                   Style="{StaticResource DefaultToggleButton3DStyle}"/>
            </other:HeaderedContentControl3D>

            <!--<other:HeaderedContentControl3D Header="CheckBox3D" Style="{StaticResource ControlSampleTemplate}">
                <xr:CheckBox3D Content="CheckBox3D"
                               ContentAlignmentZ="End"
                               FontSize="0.02"
                               IsThreeState="True"
                               SizeX="0.16"
                               SizeY="0.16"
                               SizeZ="0.04"
                               Style="{StaticResource DefaultCheckBox3DStyle}"/>
            </other:HeaderedContentControl3D>-->

            <other:HeaderedContentControl3D Header="Image3D" Style="{StaticResource ControlSampleTemplate}">
                <xr:Image3D Margin="0,0.1,0,-0.15,-0.1,0"
                            SizeX="0.16"
                            SizeY="0.16"
                            Source="/Other/Assets/FakePerson.jpg"/>
            </other:HeaderedContentControl3D>

            <other:HeaderedContentControl3D Header="GLTF Model" Style="{StaticResource ControlSampleTemplate}">
                <xr:Canvas3D SizeY="0.16" SizeZ="0.16">
                    <xr:GltfModel Scale="0.09"
                                  SizeY="0.16"
                                  SizeZ="0.16"
                                  Source="/Other/Assets/race-car/race-car.glb"/>
                </xr:Canvas3D>
            </other:HeaderedContentControl3D>

            <other:HeaderedContentControl3D Header="Text3D" Style="{StaticResource ControlSampleTemplate}">
                <xr:Text3D SizeY="0.16"
                           Text="Hello"
                           Thickness="0.01"
                           Color="Green"/>
            </other:HeaderedContentControl3D>

            <other:HeaderedContentControl3D Header="TextBlock3D" Style="{StaticResource ControlSampleTemplate}">
                <xr:TextBlock3D FontSize="18"
                                Foreground="Blue"
                                SizeY="0.16"
                                Text="Hello"/>
            </other:HeaderedContentControl3D>

            <!--<other:HeaderedContentControl3D Header="TextBox3D" Style="{StaticResource ControlSampleTemplate}">
                <xr:TextBox3D Text="Hello" Foreground="Blue" FontSize="0.16" SizeY="0.16"/>
            </other:HeaderedContentControl3D>-->
        </xr:StackPanel3D>
    </xr:Canvas3D>
</xr:UserControl3D>
